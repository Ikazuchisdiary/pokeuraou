+/// A side's party, stored inline.
+///
+/// Six is the team size and the count never changes during a battle, so the `Vec` this
+/// replaces was an allocation per side per clone -- 47 a turn, an eighth of every
+/// allocation the resolver made. The Pokemon themselves stay behind `Rc`; what is inline
+/// is the six pointers.
+#[derive(Clone, Debug, Default)]
+pub struct Party {
+    slots: [Option<Rc<Pokemon>>; MAX_PARTY],
+    len: usize,
+}
+
+pub const MAX_PARTY: usize = 6;
+
+impl Party {
+    pub fn len(&self) -> usize {
+        self.len
+    }
+
+    pub fn is_empty(&self) -> bool {
+        self.len == 0
+    }
+
+    pub fn push(&mut self, mon: Rc<Pokemon>) {
+        assert!(self.len < MAX_PARTY, "a party holds {MAX_PARTY} Pokemon, not more");
+        self.slots[self.len] = Some(mon);
+        self.len += 1;
+    }
+
+    pub fn iter(&self) -> impl Iterator<Item = &Rc<Pokemon>> {
+        self.slots[..self.len].iter().map(|slot| slot.as_ref().unwrap())
+    }
+
+    pub fn get(&self, index: usize) -> Option<&Rc<Pokemon>> {
+        self.slots.get(index).and_then(Option::as_ref)
+    }
+
+    pub fn swap(&mut self, a: usize, b: usize) {
+        self.slots.swap(a, b);
+    }
+
+    pub fn position<F: Fn(&Pokemon) -> bool>(&self, test: F) -> Option<usize> {
+        (0..self.len).find(|index| test(self.slots[*index].as_ref().unwrap()))
+    }
+}
+
+impl std::ops::Index<usize> for Party {
+    type Output = Rc<Pokemon>;
+
+    fn index(&self, index: usize) -> &Rc<Pokemon> {
+        self.slots[index].as_ref().expect("no Pokemon in that party slot")
+    }
+}
+
+impl std::ops::IndexMut<usize> for Party {
+    fn index_mut(&mut self, index: usize) -> &mut Rc<Pokemon> {
+        self.slots[index].as_mut().expect("no Pokemon in that party slot")
+    }
+}
+
+impl FromIterator<Rc<Pokemon>> for Party {
+    fn from_iter<T: IntoIterator<Item = Rc<Pokemon>>>(items: T) -> Party {
+        let mut party = Party::default();
+        for mon in items {
+            party.push(mon);
+        }
+        party
+    }
+}
+
